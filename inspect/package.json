{
  "name": "shrine-inspect",
  "version": "0.1.3",
  "description": "Health check of an AI coding setup against the SHRINE docs. Local, read-only, no network.",
  "license": "Apache-2.0",
  "author": "Stable Kernel",
  "homepage": "https://stablekernel.github.io/SHRINE/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stablekernel/SHRINE.git",
    "directory": "inspect"
  },
  "bugs": {
    "url": "https://github.com/stablekernel/SHRINE/issues"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "shrine-inspect": "bin/shrine-inspect.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "skill/",
    "README.md",
    "TRIAL.md"
  ],
  "scripts": {
    "test": "node scripts/test.mjs",
    "lint": "node scripts/lint-readonly.mjs && node scripts/lint-copy.mjs && node scripts/lint-network.mjs",
    "test:visual": "playwright test -c playwright.config.mjs",
    "build:catalogue": "node scripts/build-catalogue.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "acorn": "8.15.0",
    "playwright": "1.64.1"
  }
}
